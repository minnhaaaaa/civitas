CIVITAS_POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://civitas:civitas_dev@localhost:55432/civitas
POSTGRES_DB=civitas
POSTGRES_USER=civitas
# Local demo only. Replace with a non-secret-manager-injected runtime value in production.
POSTGRES_PASSWORD=civitas_dev
CIVITAS_API_PORT=8000
CIVITAS_MCP_PORT=8001
CIVITAS_ENV=development
CIVITAS_LOG_FORMAT=json
CIVITAS_SERVICE_NAME=civitas-mcp
CIVITAS_WORKER_ID=worker-local-1
CIVITAS_REQUIRE_WORKER_READY=false
CIVITAS_WORKER_READINESS_SECONDS=120
CIVITAS_HEARTBEAT_INTERVAL_SECONDS=10
CIVITAS_LIVE_PROVIDER_REQUIRED=false
# Production must point to an installed secret-backed provider bootstrap.
# CIVITAS_PROVIDER_FACTORY=your_package.runtime:create_provider_dependencies
CIVITAS_AUDIT_VIEWER_ENABLED=false
# CIVITAS_AUDIT_VIEWER_BASE_URL=http://127.0.0.1:5173
# CIVITAS_AUDIT_LINK_SECRET=local-audit-link-secret-change-this-value
CIVITAS_AUDIT_LINK_TTL_SECONDS=900
CIVITAS_APPROVAL_SECRET_PEPPER=local-approval-pepper-change-this-value
CIVITAS_BEARER_TOKEN=local-bearer-token-change-this-value-now
CIVITAS_ORGANIZATION_ID=org-local
CIVITAS_OPERATOR_ID=operator-local
